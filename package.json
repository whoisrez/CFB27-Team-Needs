{
  "name": "cfb27-team-needs",
  "productName": "CFB 27 Team Needs",
  "version": "0.1.0",
  "description": "Standalone CFB 27 roster planning and Team Needs utility",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck",
    "release:verify-output": "node scripts/verify-release-output.cjs",
    "release:check": "npm run verify && npm run make && npm run release:verify-output"
  },
  "author": "tyrez",
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron-forge/shared-types": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^22.10.0",
    "electron": "43.3.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1",
    "madden-franchise": "^4.3.1"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "electron-winstaller@5.4.4": true
  }
}

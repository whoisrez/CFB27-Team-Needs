{
  "compilerOptions": {
    "target": "ESNext",
    "module": "preserve",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts", "forge.config.ts", "vite.*.config.ts", "forge.env.d.ts"]
}
